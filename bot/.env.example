# =============================================================================
# BOT DO TELEGRAM -- copie para bot/.env e preencha
# =============================================================================
# Este arquivo NAO entra no app: o bot roda no servidor. Por isso aqui pode
# existir a service role key, que no .env do app seria um vazamento total.
# =============================================================================

# Token do bot, dado pelo @BotFather no Telegram.
BOT_TOKEN=

# Mesmo projeto Supabase do app.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave que IGNORA todas as policies do banco. Se ela vazar, o banco inteiro
# vaza. Nunca coloque no .env do app, nunca commite, nunca mande por mensagem.
SUPABASE_SERVICE_ROLE_KEY=
