# =============================================================================
# VARIAVEIS DO APP (tablet) -- copie para .env e preencha
# =============================================================================
# ATENCAO: tudo que esta aqui entra no bundle do Expo (app.config.js -> extra) e
# pode ser lido por qualquer pessoa que descompacte o APK.
#
#   ESTE ARQUIVO SO ACEITA O QUE PODE SER PUBLICO.
#
# Credencial de pagamento NAO vem para ca -- ela e secret de Edge Function e
# fica so no servidor. A lista completa esta em CREDENCIAIS.md.
# =============================================================================

# URL do projeto Supabase (painel > Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave "anon/public". E publica por definicao: identifica o app, nao autoriza
# nada sozinha -- quem decide o que pode acontecer sao as policies e as Edge
# Functions.
SUPABASE_ANON_KEY=

# E-mail do admin do painel. Fica visivel no app; a senha nunca.
ADMIN_EMAIL=

# =============================================================================
# NAO ADICIONE AQUI
# =============================================================================
# Estas chaves JA foram removidas de proposito. Recolocar qualquer uma faz o
# segredo vazar junto com o APK:
#
#   EFI_CLIENT_ID, EFI_CLIENT_SECRET, EFI_PIX_KEY, EFI_SANDBOX
#   INFINITIPAY_API_KEY
#   ZAPI_INSTANCE_ID, ZAPI_TOKEN, ZAPI_CLIENT_TOKEN
#
# O envio por WhatsApp (Z-API), quando for implementado, tambem precisa nascer
# como Edge Function -- nunca como chamada feita pelo tablet.
# =============================================================================
